  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - '???: Hello there! '
  - 'Rana: Hello.'
  - '???: You are a new face young lady! How may I save this fair maiden?'
  - 'Rana: ... I don''t need saving really.'
  - '???: Nonsense! You just have an overdeveloped ego! I''ll save you from it!'
  - 'Rana: I think I''ll pa-'
  - '???: You''re short and wear toddler sized pants! Not to mention almost as ugly
    as a goblin!'
  - 'Rana: Uhh...'
  - '???: That oughta help you stay level headed! You''re welcome!'
  - 'Rana: Thanks?'
  - '???: That''ll be 20 gold for the might Hensons services! '
  - 'Rana: I''m gonna leave now. '
