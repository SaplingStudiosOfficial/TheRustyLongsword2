  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - 'Rana: Wow that Henson guy sure is off.'
  - 'Mr. Smith: Oh, you met him?'
  - 'Rana: Yeah, he kinda just started insulting me.'
  - "Mr. Smith: Yeah he wants to help, sometimes too much. He, uh, doesn\u2019t talk
    to many people.  "
  - "Rana:  Why\u2019s that?  "
  - "Mr. Smith: I\u2019ve known Henson since he was a tadpole, a good friend to talk
    to would do that boy some good.  "
  - 'Rana:  I sure hope he can make a friend some time.  '
  - "Mr. Smith:  Hey, bartenders are pretty charismatic. Why don\u2019t you teach
    him how to make friends? "
  - "Rana:  Uh\u2026 "
  - 'Mr. Smith: Well if you ever wanna do some good just talk to him. Would you rather
    he keep insulting strangers?'
  charactersSpeaking: 02000000060000000200000006000000020000000600000002000000060000000200000006000000
