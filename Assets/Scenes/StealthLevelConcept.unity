  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - '???: Howdy! Welcome tah Town, hermano!  '
  - 'Rana: Oh cool a western town!'
  - "???: Yup! Nothin\u2019 fake \u2018bout these parts! All completely accurate
    here in Eastwood! N I'm da sherriff!"
  - 'Rana: So, what else goes on here? '
  - "Sherriff: What else? Other than root tooting and hoot bootin\u2019 we don\u2019t
    nothing else! Yee-haw! "
  - 'Rana: Oh cool! '
  - 'Sherriff: Well that''s nice. I hope your trip goes well. '
  - 'Rana: Thanks. Do you sell much in a town like this? '
  - 'Sherriff: Well Henson sure breaks a lot of stuff fighting off trees. So I get
    pretty good business here.'
