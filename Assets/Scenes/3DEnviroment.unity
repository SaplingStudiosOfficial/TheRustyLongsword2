--- !u!114 &602245861
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 602245859}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - 'Rana: H- Hey, Sorry. I know I don''t come over often. I''m just so bus-'
  - 'Rana: I''m sorry, I should come over more often.'
  - 'Rana: I''ve been doing better. I''m still trying to do better. Even after all
    these years.'
  - 'Rana: I saw some wacky stuff coming up here. It wasnt so crouded last time I
    came up.'
  - 'Rana: I saw a giant frog who needed a friend. '
  - 'Rana: You would not believe how many cowboy hats are on this island now. '
  - 'Rana: And this teacher just south of us has a fri-'
  - 'Rana: ...'
  - 'Rana: I still miss you.'
  - 'Rana: After all this time it still hurts. But I think thats ok, because maybe
    all this pain means I still love you.'
  - 'Rana: I still love you. '
  - 'Rana: ...'
  - 'Elder Tree: Pardon me. '
  - 'Rana: Yeah?'
  - 'Elder Tree: Do you remember what the etching on this stone said before the years
    removed it?'
  - 'Rana: Huh?'
  - 'Elder Tree: It seems to me that you have forgotten something important.'
  - 'Rana: What did it say? '
  - 'Elder Tree: "Proud of those left behind."'
  - 'Rana: ...'
  - 'Rana: Thanks'
  charactersSpeaking: 020000000200000002000000020000000200000002000000020000000200000002000000020000000200000002000000060000000200000006000000020000000600000002000000060000000200000002000000
