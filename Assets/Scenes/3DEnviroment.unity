--- !u!114 &1348661927
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1348661925}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - 'Rana:  Uh. Hey. '
  - 'Henson:  Hey there! Is a dragon coming to kidnap you fair maiden!? '
  - "Rana:  No, also I\u2019m not a maiden.  "
  - 'Henson:  Oh, you were just so short and weak I assumed.  '
  - "Rana:  Ok, I\u2019m not even gonna go there. Say, I\u2019m sad though.  "
  - 'Henson:  I can save you! I need simply do something really coo- '
  - 'Rana:  How about we play a game? That would really lift my spirits. '
  - "Henson:  If that\u2019s what it takes, let's do it! Did you have a game in mind?  "
  - 'Rana:  My family has this really fun game where we pretend to be strangers becoming
    friends! Have you ever played? '
  - "Henson: Can\u2019t say I have! Just explain the rules! I\u2019m sure a strong
    man-toad like me will do well! "
  - "Rana:  Ok so just act like we just met! And are making friends! I\u2019ll start!  "
  - 'Henson:  Play away!  '
  - "Rana:  Hello stranger! How\u2019s the door punching going?  "
  - "Henson: It\u2019s going great! My rippling muscles and keen eye make me really
    good at it!  "
  - 'Rana:  Can I try? '
  - 'Henson:  No, youre really small, which means your brain is probably small, so
    youre probably too weak and stupid to try it- '
  - 'Rana:  Time out!  '
  - 'Henson:  What happened, gnome? '
  - 'Rana:  Well the way you win the game is by being nice. So when the new person
    wants to try something youre supposed to help them out '
  - "Henson:  Oh! Ok, let\u2019s untimeout! "
  - "Rana:  Ok, let\u2019s redo it.  GO! "
  - 'Henson:  Say, I want a drink.'
  charactersSpeaking: 02000000040000000200000004000000020000000400000002000000040000000200000004000000020000000400000002000000040000000200000004000000020000000400000002000000040000000200000004000000
