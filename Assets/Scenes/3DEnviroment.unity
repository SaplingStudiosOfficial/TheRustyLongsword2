--- !u!114 &1328230867
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1328230865}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - '???: Now where on earth could I have left my notebook.'
  - '???: Oh Howdy Pardner.'
  - "Rana: Howdy! Don\u2019t mind me stranger I\u2019m just passing through town. "
  - "???: Well nice to meet ya stranger! I\u2019m Jesse, not ta brag but I\u2019m
    the deputy in these parts"
  - "Rana: Well Jesse nice to meet ya! How\u2019s everything going this fine day?"
  - 'Jesse: Eh pretty good, I got this cow to ride now so us being cowboys makes
    a little more sense.'
  - "Rana I don\u2019t think thats-"
  - 'Jesse: Yep, cowboys and coys, a match made in the heavens.'
  - 'Jesse: Say I never got ur name!'
  - "Rana: Name\u2019s Rana. "
  - 'Jesse: Well Rana, can I tell you a secret? '
  - 'Rana: My lips are sealed.'
  - "Jesse: I always liked cows better. Horses aint\u2026 round."
  - "Rana: Well, good for you. Say, didn\u2019t something happen to the sheriffs
    horse round these parts last night"
  - "Rana:  He wouldn\u2019t stop talking about his horse when I was walking in. "
  - "Jesse: Uh! I wouldn\u2019t know! I wouldn\u2019t know a thing. I was up with
    my friends in the town up the mountain last night."
  - "Jesse: We haven't been able to go over ever now that darn Sheriff Clint dun
    closed the gate. But the horse didn\u2019t come when I whistled this morning."
  - 'Rana: How sad, the horse got butchered apparently. '
  - 'Jesse: GASP'
  - "Rana: Did you just say \u201CGASP\u201D? "
  - 'Jesse: *gasps*'
  - 'Jesse: Say friendo, could you keep an eye out for a note book?'
  - 'Rana: Sure. Yours?'
  - 'Jesse: Yep.'
  charactersSpeaking: 050000000500000002000000050000000200000002000000050000000200000005000000020000000500000002000000050000000200000002000000050000000500000002000000050000000200000005000000050000000200000005000000
