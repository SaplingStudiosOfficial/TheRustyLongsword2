  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - 'Itachi:  Uh, Oh nO StoP WhO GoEs ThERe.'
  - 'Rana:  Hello, Sir-'
  - 'Itachi: Hey, Welcome to Boenaha. You must be the new ninja.'
  - 'Rana: Uh, no-'
  - 'Itachi: NONESENSE!'
  - 'Rana:  Ow my ears-'
  - 'Itachi:  Everyone here is a ninja!'
  - 'Itachi:  *Hyah* Even the cats.'
  - 'Rana:  Nah I''m just a ba-'
  - 'Itachi:  In this village lives a young boy named Ankoku, when he was born the
    village was attacked by a 9 tailed f- '
  - 'Rana:  Listen man, I''m just a bartender. Unless he wants a drink- wait Is he
    even old enough to drink? '
  - 'Itachi:  ...'
  - 'Rana:  See ya later. '
