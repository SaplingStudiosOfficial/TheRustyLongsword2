  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - 'Jessy: Oh my gosh you found my tablet!'
  - 'Rana: Sure did!'
  - 'Jessy: Amazing! Can I have it back now? '
  - 'Rana: Wait wait you said I got to have one question!'
  - 'Jessy: Oh yeah ahah sorry I forgot.'
  - 'Rana: Ok how do I ask? '
  - 'Jessy: Welp, you just ask it, the tablet will answer.'
  - 'Rana:  Okay... here I go.'
  - 'Rana: ...'
  - 'Rana: Oh tablet-'
  - 'Jessy: Sheesh it''s not ancient, you dont go "Oh great tablet"'
  - 'Jessy: To turn it on just say "Hey Tabby"'
  - 'Rana: ... ok'
  - 'Rana: Hey Tabby, who is the one that Sherrif Clint seeks.'
  - 'Jessy: !'
  - 'Tablet: There is no "one", they are more than one.'
  - 'Rana: Wait! Who!?'
  - 'Jessy: Sorry it only does one question.'
  - 'Jessy: Now if you''ll excuse me I have friends to check up on.'
  - 'Rana: Wait...'
  - 'Jessy: Yeah? '
  - 'Rana: Yall are all invited to the bar tonight...'
  - 'Rana: Everyone...'
  charactersSpeaking: 0200000006000000020000000600000002000000060000000200000006000000020000000600000006000000060000000600000006000000060000000600000006000000060000000600000006000000060000000600000006000000
