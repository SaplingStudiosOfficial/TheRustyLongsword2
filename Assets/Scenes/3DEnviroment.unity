  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - 'Itachi: New Ninja! '
  - 'Rana: Not a ninja- '
  - 'Itachi: I have a quest for you- '
  - 'Rana: Not down for quests. '
  - "Itachi: \u2026 "
  - 'Itachi: Please? '
  - 'Rana: You sound desperate. '
  - "Itachi: We\u2019ll if I\u2019m being honest I kinda wanna keep this matter under
    the rug but I\u2019m too big to fix it. "
  - 'Rana: What do you mean by that? '
  - "Itachi: I left one of my uh- novels, on a robo-boat during a mission and I don\u2019t
    want anyone catching one to me coming back to get it. "
  - 'Rana: So I just walk in and grab it. '
  - 'Itachi:  Well yeah but yah might want to not get seen doing it. '
  - "Itachi:They\u2019re a little\u2026 aggitated. I killed their sensei, might be
    keeping it ransom."
  - 'Rana: Oh boy.'
  charactersSpeaking: 0600000002000000060000000200000006000000060000000200000006000000020000000600000002000000060000000600000002000000
