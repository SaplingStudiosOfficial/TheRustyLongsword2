MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1318703182}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - 'Rana: Hey, I found you''re script! '
  - 'Winston: Thanks Pardner!'
  - 'Rana: Say! Why don''t we do a little reading?'
  - 'Winston: Real weird to want to read so much but sure! '
  - 'Rana: Thanks partner! What page do the mystery clues start on again?'
  - 'Winston: That would be page 37'
  - 'Rana: Let''s start there! '
  - 'Winston: Mmmhmm. *clears throat*'
  - 'Winston: Say Jesse, ya think Jessy will ever find the tablet?'
  - 'Rana: Nah Partner, we hid that thing way out in the desert.'
  - 'Rana: Even if she does find it, how would she ever link it to us? '
  - 'Winston: Aw you''re right Jesse, say, you still got it right?'
  - 'Rana: ...'
  - 'Winston: What happened? '
  - 'Rana: The next page is blank. '
  - 'Winston: Well I didn''t even need it. That sure was a rootin tooting time reading!'
  - 'Rana: Thanks. I''ll see you later. '
  charactersSpeaking: 0200000006000000020000000600000002000000060000000200000006000000060000000200000002000000060000000200000006000000020000000600000002000000
