  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - '???: Howdy! Welcome to Hatfield! You may be asking yourself: Why are all these
    people wearing hats? [Press the F key to continue Dialog]'
  - '???: Well Hatfield here has a long and detailed History! '
  - '???: A couple weeks ago we all went camping and when we came back nobody could
    tell whose house was whose!'
  - '???: So I had the bright idea to put hats on each mound. And the person wearing
    the matching hat lives there!'
  - '???: I''m still trying to figure out what to do if more than one person lives
    in a mound though.'
  - '???: Who am I?! My name is Marcome King. I''m the Mayor of this Town.'
  - 'Mayor King: Have a great time and remember to get to know the people around
    here! They love visitors!'
  charactersSpeaking: 01000000010000000100000001000000010000000100000001000000
  index: 0
  textDisplay: {fileID: 878324140}
  typingSpeed: 0.02
  player: {fileID: 671116192}
