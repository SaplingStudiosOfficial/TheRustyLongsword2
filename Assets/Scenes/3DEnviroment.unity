--- !u!114 &1263349634
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1263349632}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - 'Yurei:  Ankoku! You dont know suffering like mine! '
  - "Ankoku:  Don\u2019t say that Yurei! We\u2019re best friends! "
  - 'Yurei:  Lighting Bla- '
  - 'Rana:  Hey kids. '
  - 'Ankoku:  WHOA! Who are you!  '
  - 'Rana: Is everyone here screaming all the time? '
  - 'Ankoku:  We were in the middle of something is it important?  '
  - "Rana:  Yeah, just wanted to let y\u2019all know that my bars going to be open
    tonight, you kids should come on by.  "
  - "Yurei: Sorry I don\u2019t drink Sake. "
  - 'Rana: Sasuke? What is that? Well if yall have time at least stop by and say- '
  - 'Ankoku: We would love to but- '
  - 'Rana: Oh boy here we go- '
  - 'Ankoku: We have too many ninja scrolls to complete, hey maybe if you did one
    for us we could come over! '
  - 'Rana:  Maybe, what is it? '
  - 'Yurei: Some weak robo-pirates set landed their ship just behind this building
    and stole the town cat her cat. '
  - 'Yurei: We have a scroll to get it back, we just need you to use your gnome magic
    to sneak in and take the cat back!'
  - 'Rana: Gnome magic? '
  - "Ankoku: Can\u2019t gnomes teleport right before they\u2019re about to be seen? "
  - 'Rana: Uhhh.'
  - "Yurei: We\u2019ll were not coming to your bar unless it\u2019s dealt with so
    scram! "
  - "Rana: Gosh kid chill\u2026 "
  charactersSpeaking: 030000000400000003000000020000000400000002000000040000000200000003000000020000000400000002000000040000000200000003000000030000000200000004000000020000000300000002000000
  index: 0
  textDisplay: {fileID: 878324140}
  typingSpeed: 0.02
  player: {fileID: 671116192}
