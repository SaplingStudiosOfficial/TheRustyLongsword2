--- !u!114 &571672065
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 571672063}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - '???: Reach fer tha sky!'
  - 'Rana: Wow am I really getting robbed by a real outlaw!?'
  - '???: Sure are pardner! By the outlaw Winston!'
  - 'Rana: Wow this is awesome!'
  - "Winston: Now you empty them pockets and don\u2019t nobody gotta get hurt. "
  - "Rana: I actually don\u2019t have pockets."
  - 'Winston: Yeah now hand em- wait what?'
  - "Rana: Uhh, sorry mister I don\u2019t got no pockets!"
  - "Winston: Oh shoot I don\u2019t know what to say if they don\u2019t got pockets.
    The script didn\u2019t say!"
  - 'Rana: Uhh, maybe something like'
  - "Rana: \u201CWell ya better pull something out of somewhere if ya wanna make
    it out alive pardner!\u201D"
  - "Winston: Oh wow that\u2019s so good! Ok here I go:"
  - "Winston: \u201CYa betta\u201D"
  - 'Winton: no.'
  - "Winston: \u201CYa better pull- \u2026\u201D *nervous breathing*"
  - 'Rana: Deep breaths.'
  - "Winston: \u2026 \u201CYa\u201D"
  - "Winston: Ah who am I kidding! Sorry I can\u2019t rob ya. "
  - "Rana: Hey I\u2019m not gonna complain."
  - "Winston: It was a long night last night and I just don\u2019t got it in me.
    I can\u2019t focus on anything since I lost my script!"
  - "Winston:  I don\u2019t remember stuff too good."
  - 'Rana: Hmm, if I brought ur script back could you do a little reading with me
    to practice? '
  - 'Winston: I would do anything if you found it! '
  - "Rana: Well I\u2019ll keep an eye out. "
  - "Winston: Well I\u2019ve already looked behind the sheriffs office but all I
    found was some notebook."
  - "Winston:  But I haven\u2019t checked anywhere else."
  - 'Rana: Thanks I won''t look there.'
  charactersSpeaking: 030000000200000003000000020000000300000002000000030000000200000003000000020000000200000003000000030000000300000003000000020000000300000003000000020000000300000003000000020000000300000002000000030000000300000002000000
