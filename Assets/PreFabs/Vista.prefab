--- !u!114 &6917736396364018465
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6917736396364018470}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e4d333fa1048a3642a8067a367f2cfd7, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sentences:
  - '???: Hello. Welcome to Hatfield. Please do not eat too much. I have a hard enough
    time feeding the frog.'
  - 'Rana: No problem. I actually came prepared to feed people here. '
  - '???: Oh, I was not aware you spoke. '
  - 'Rana: Yeah the mayor just kept talking without stopping...'
  - '???: So... why are you here.'
  - 'Rana: I actually have a bar. I''m just taking a few days to make my way up the
    mountain.'
  - '???: Why would you move location so much?'
  - 'Rana: Something really valuable is up there.'
  - '???: Well may you make it with all your limbs intact and in good condition.'
  - 'Rana: Uh. Thanks. I never got your name by the way.'
  - '???: I am Farmer Kl3p. The Mayor bought me cause he''s too la- for a job offer
    feeding villagers.'
  - 'Farmer Kl3p: It''s good work. Sometimes I find cool stuff on the ground. People
    drop a lot of stuff here.'
  charactersSpeaking: 
  index: 0
  textDisplay: {fileID: 0}
  typingSpeed: 0.02
  player: {fileID: 0}
  TextBox: {fileID: 0}
  NPC: {fileID: 6917736395265671461}
